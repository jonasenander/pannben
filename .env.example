# Copy to .env and fill in your own values. .env is gitignored — keep it that way.

# The MagicDNS name Tailscale Serve publishes the app on.
PANNBEN_HOSTNAME=your-nas.your-tailnet.ts.net

# Host directory holding pannben.db and the nightly snapshots.
PANNBEN_DATA_DIR=/path/to/docker/pannben

# Port the container listens on, bound to loopback only.
PANNBEN_PORT=8080

# Session dates are calendar dates in this zone.
TZ=Europe/Stockholm
