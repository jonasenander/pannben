# Copy to .env and fill in your own values. .env is gitignored — keep it that way.

# The MagicDNS name Tailscale Serve publishes the app on.
PANNBEN_HOSTNAME=your-nas.your-tailnet.ts.net

# Host directory holding pannben.db and the nightly snapshots.
# Must be writable by uid 10001 — the unprivileged user the container runs as:
#   sudo chown -R 10001:10001 <this directory>
PANNBEN_DATA_DIR=/path/to/docker/pannben/data

# Host port, published on loopback only and proxied by Tailscale Serve.
#
# 8225 rather than the usual 8080 purely to avoid collisions: on a Synology,
# 8080 is contested by Web Station, Portainer and a long tail of containers,
# and a clash shows up as a container that quietly fails to start after a
# reboot. It is not a security measure — a socket bound to 127.0.0.1 is
# unreachable from the LAN whatever its number, and anything already on the
# NAS finds it with one `ss -ltnp`. Tailscale is the access control.
#
# Change this if 8225 is taken. Check first with:  ss -ltn | grep 8225
PANNBEN_HOST_PORT=8225

# Session dates are calendar dates in this zone.
TZ=Europe/Stockholm
